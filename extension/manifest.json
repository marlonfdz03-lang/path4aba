{
  "manifest_version": 3,
  "name": "Path4ABA",
  "version": "1.0.1",
  "description": "Clinical documentation for ABA professionals — generate and refine notes from any webpage.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://path4aba.app/*",
    "https://*/*",
    "*://*.officepuzzle.com/*",
    "*://fkbac.officepuzzle.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.abamatrix.com/*"],
      "js": [
        "engine/core/scanner.js",
        "engine/core/normalizer.js",
        "engine/adapters/ABAMatrixAdapter.js",
        "engine/debug.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.abamatrix.com/*"],
      "js": ["form-agent.js"],
      "run_at": "document_idle"
    }
  ]
}
