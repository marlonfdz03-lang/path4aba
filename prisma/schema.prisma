generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model clients {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internal_code             String?
  clinical_profile          Json?
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  active_behaviors          Json?
  agency_id                 String?
  created_by                String?
  diagnosis                 String?
  primary_setting           String?
  rbt_id                    String?
  authorized_hours_weekly   Float?    @default(0)
  treatment_map_approved    Boolean?  @default(false)
  treatment_map_data        Json?
  bcba_clients              bcba_clients[]
  client_access_codes       client_access_codes[]
  maladaptive_data          maladaptive_data[]
  missed_hours              missed_hours[]
  parent_training_notes     parent_training_notes[]
  progress_reports          progress_reports[]
  replacement_data          replacement_data[]
  session_notes             session_notes[]
  gate_findings             gate_findings[]
  stos                      stos[]
  supervision_notes             supervision_notes[]
  supervision_notes_97153xp     supervision_notes_97153xp[]
  clinical_timeline_entries     clinical_timeline_entries[]
  client_files                  client_files[]
}

// Stored source assessment PDFs (BYTEA). Matches migration 20260805000000_add_client_files. The model MUST
// be in the schema so `postinstall: prisma generate` produces the client_files delegate that storeClientFile
// uses — without it the deployed build's Prisma client lacks client_files and every upload 500s.
model client_files {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id   String   @db.Uuid
  uploaded_by String
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  filename    String
  mime_type   String
  size_bytes    Int
  data          Bytes
  superseded_at DateTime? @db.Timestamptz(6) // NULL = current; a timestamp = when a newer upload superseded it (bytes retained)
  clients       clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([client_id])
}

model session_notes {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String?   @db.Uuid
  user_id             String?
  note_text           String?
  session_date        String?
  behaviors_addressed String[]
  skills_addressed    String[]
  interventions_used  String[]
  activities_used     String[]
  review_status       String?
  reviewed_by         String?
  reviewed_at         DateTime? @db.Timestamptz(6)
  review_comment      String?
  // Authoritative lifecycle marker for "which note was used for this date":
  // 'saved' (kept via the web note UI) | 'used' (pushed into the EHR by the extension) | 'draft'
  // (reserved). NULL = legacy row written before this marker existed (provenance unknown).
  status              String?
  // What the preselector chose per note (rotation + continuity history source; keys/labels only, no
  // narrative). NULL for legacy rows — the reader derives function from note_text and treats axes the
  // legacy save path never stored as UNKNOWN. See migration 20260819100000_add_generation_context.
  generation_context  Json?     @db.JsonB
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  client              clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model subscriptions {
  id                            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                       String    @unique
  plan                          String?
  status                        String?
  trial_ends_at                 DateTime? @db.Timestamptz(6)
  current_period_ends_at        DateTime? @db.Timestamptz(6)
  stripe_customer_id            String?
  stripe_subscription_id        String?
  bcba_students_status          String?
  bcba_students_trial_ends_at   DateTime? @db.Timestamptz(6)
  bcba_students_subscription_id String?
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
}

model bcba_clients {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bcba_id      String
  client_id    String    @db.Uuid
  rbt_id       String?
  connected_at DateTime? @default(now()) @db.Timestamptz(6)
  client       clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([bcba_id, client_id])
}

model fieldwork_sessions {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String
  session_date      String
  month_year        String
  start_time        String?
  end_time          String?
  independent_hours Float     @default(0)
  supervised_hours  Float     @default(0)
  total_hours       Float     @default(0)
  activity_type     String?
  contact_type      String?   @default("none")
  setting           String?
  supervisor_name   String?
  session_note      String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  activity_category String?
  is_locked         Boolean   @default(false)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  client_reference  String
  // Soft delete: the delete route sets these instead of DELETEing, so an accidentally-deleted month of
  // fieldwork (supervised hours toward BACB cert) can be restored. deleted_by is kept for an audit trail —
  // "who deleted it, when" — not just blind restore. Reads are filtered (deleted_at: null) globally by a
  // Prisma client extension in lib/prisma.ts; restore via scripts/restore-fieldwork-session.ts.
  deleted_at        DateTime? @db.Timestamptz(6)
  deleted_by        String?
}

model fieldwork_monthly_summaries {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String
  month_year              String
  total_independent_hours Float     @default(0)
  total_supervised_hours  Float     @default(0)
  total_hours             Float     @default(0)
  supervision_pct         Float     @default(0)
  unrestricted_hours      Float     @default(0)
  restricted_hours        Float     @default(0)
  supervisor_contacts     Int       @default(0)
  individual_contacts     Int       @default(0)
  group_contacts          Int       @default(0)
  client_observations     Int       @default(0)
  is_eligible             Boolean   @default(false)
  ineligibility_reason    String?
  mvf_signed              Boolean   @default(false)
  mvf_signed_at           DateTime? @db.Timestamptz(6)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([user_id, month_year])
}

model fieldwork_profiles {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @unique
  fieldwork_type       String?
  certification_track  String?
  trainee_bacb_id      String?
  supervisor_name      String?
  supervisor_bacb_id   String?
  onboarding_complete  Boolean   @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  country_of_fieldwork String?
  start_date           String?
  state_of_fieldwork   String?
  supervisor_email     String?
}

model client_access_codes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id  String    @db.Uuid
  rbt_id     String?
  code       String    @unique
  expires_at DateTime? @db.Timestamptz(6)
  used       Boolean   @default(false)
  used_by    String?
  created_by String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  client     clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model supervision_notes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id        String?   @db.Uuid
  bcba_id          String?
  rbt_id           String?
  session_date     String?
  supervision_type String?
  note_text        String?
  status           String?   @default("draft")
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  client           clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model parent_training_notes {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String?   @db.Uuid
  bcba_id            String?
  session_date       String?
  caregiver_name     String?
  caregiver_relation String?
  note_text          String?
  status             String?   @default("draft")
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  client             clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model missed_hours {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id  String?   @db.Uuid
  rbt_id     String?
  date       String?
  reason     String?
  hours      Float?
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  client     clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model clinical_timeline_entries {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id   String    @db.Uuid
  date        String
  type        String
  title       String
  summary     String?
  metadata    Json?
  created_by  String?
  source      String?
  importance  String?   @default("medium")
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  client clients? @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, type, title])
}

model behaviors {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  category           String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  description        String?
  replacement_skills replacement_skills[]
  topographies       topographies[]
}

model topographies {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  behavior_id         String    @db.Uuid
  description         String?
  measurable_unit     String?
  severity_level      Int?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  vocabulary_variants String[]
  behavior            behaviors @relation(fields: [behavior_id], references: [id], onDelete: Cascade)
}

model supervision_notes_97153xp {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id           String?   @db.Uuid
  bcba_id             String?
  session_date        String?
  note_text           String?
  rbt_session_context Json?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  client              clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model replacement_skills {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skill_description   String?
  function_targeted   String?
  behavior_id         String?    @db.Uuid
  created_at          DateTime?  @default(now()) @db.Timestamptz(6)
  teaching_procedure  String?
  vocabulary_variants String[]
  behavior            behaviors? @relation(fields: [behavior_id], references: [id])
}

model replacement_data {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id             String    @db.Uuid
  session_date          String?
  location              String?
  session_time_in       String?
  session_time_out      String?
  rbt_name              String?
  platform_source       String?
  replacement_skill     String
  total_trials          Int
  observed_percentage   Float
  correct_count         Int
  incorrect_count       Int
  alternated_sequence   String?
  user_confirmed        Boolean   @default(false)
  confirmed_at          DateTime? @db.Timestamptz(6)
  autofill_completed    Boolean   @default(false)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  week_start            String?
  week_end              String?
  projected_value       Float?
  goal_met              String?
  week_confirmed        Boolean   @default(false)
  week_confirmed_at     DateTime? @db.Timestamptz(6)
  anomaly_justification String?
  anomaly_reviewed      Boolean   @default(false)
  is_anomaly            Boolean   @default(false)
  original_value        Float?
  client                clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model maladaptive_data {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id             String    @db.Uuid
  behavior_name         String
  week_start            String?
  week_end              String?
  session_date          String?
  frequency             Int?
  rate                  Float?
  duration              Float?
  trials                Int?
  daily_values          Json?
  user_confirmed        Boolean   @default(false)
  confirmed_at          DateTime? @db.Timestamptz(6)
  projected_value       Float?
  goal_met              String?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  anomaly_justification String?
  anomaly_reviewed      Boolean   @default(false)
  is_anomaly            Boolean   @default(false)
  original_value        Float?
  autofill_completed    Boolean   @default(false)
  client                clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model stos {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id      String    @db.Uuid
  target_name    String
  target_type    String
  baseline_value Float
  goal_value     Float
  start_date     String?
  target_date    String?
  total_weeks    Int       @default(16)
  status         String    @default("active")
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  client         clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model progress_reports {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String    @db.Uuid
  rbt_id             String
  period_start       String
  period_end         String
  period_label       String
  behavior_trends    Json?
  skill_trends       Json?
  goal_progress      Json?
  narrative          String?
  continuity_context Json?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  client             clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, period_start, period_end])
}

model promo_codes {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique
  discount_amount Float?
  max_uses        Int?
  current_uses    Int       @default(0)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
}

model bcba_notes {
  note          String?
  category      String?
  activity_type String?
  id            Int     @id @default(autoincrement())
}

model users {
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String?
  name               String?
  role               String             @default("rbt")
  emailVerified      DateTime?          @db.Timestamptz(6)
  image              String?
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  data_tab_enabled   Boolean            @default(false)
  pending_email      String?
  email_verify_token String?
  accounts           accounts[]
  extension_tokens   extension_tokens[]
  sessions           sessions[]
}

model extension_tokens {
  id           String    @id @default(cuid())
  user_id      String
  token_hash   String    @unique
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model accounts {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model sessions {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(6)
  user         users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification_tokens {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@id([identifier, token])
}

// Compliance-gate findings. The gates NEVER block a note reaching the RBT — a clinical gate firing
// is a signal to us, not a failure for them — so every finding is recorded here silently and
// reviewed in the admin panel. Deliberately holds NO note text: ids and short clinical labels only,
// enough to diagnose a root cause, nothing more. Admin-only by route auth.
model gate_findings {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  client_id   String?   @db.Uuid
  user_id     String?
  note_id     String?   @db.Uuid
  source      String
  gate        String
  severity    String
  detail      String
  context     Json?
  regen_count Int?      @db.SmallInt
  client      clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([created_at(sort: Desc)])
  @@index([gate, created_at(sort: Desc)])
  @@index([severity, created_at(sort: Desc)])
  @@index([client_id])
}
