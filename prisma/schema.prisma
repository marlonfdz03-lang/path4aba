// Per-client, per-program MEASUREMENT settings — how a program is recorded, not what it aims for.
// Distinct from `stos`: that table holds short-term OBJECTIVES (baseline/goal/target date) and carries no
// unique constraint because one target accumulates many objectives over time; this one is unique per
// program because a program has exactly one trial count. Kept out of clinical_profile because the natural
// placement (inside maladaptiveBehaviors[]/replacementBehaviors[]) is rebuilt wholesale by every
// reassessment, and a sibling top-level key would be reverted by the profile-restore undo. See migration
// 20260828000000_monthly_datasheet_fields.
//
// program_name is a SOFT reference matched by name against clinical_profile / behavior_name /
// replacement_skill — none of which have a canonical key — so a rename orphans the config rather than
// corrupting it. CASCADE on client delete: this is configuration, not evidence.
model program_config {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String   @db.Uuid
  program_name       String
  program_type       String   // 'maladaptive' | 'replacement'
  trials_per_session Int?     // NULL = not configured; the caller decides its own fallback
  mastery_criterion  String?  // free text, e.g. '80% across 3 consecutive sessions'
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  client             clients  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Leading column is client_id, so this also serves every "config for this client" lookup — a separate
  // @@index([client_id]) would be redundant.
  @@unique([client_id, program_name, program_type])
}

