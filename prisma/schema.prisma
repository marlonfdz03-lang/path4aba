// Compliance-gate findings. The gates NEVER block a note reaching the RBT — a clinical gate firing
// is a signal to us, not a failure for them — so every finding is recorded here silently and
// reviewed in the admin panel. Deliberately holds NO note text: ids and short clinical labels only,
// enough to diagnose a root cause, nothing more. Admin-only by route auth.
model gate_findings {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  client_id   String?   @db.Uuid
  user_id     String?
  note_id     String?   @db.Uuid
  source      String
  gate        String
  severity    String
  detail      String
  context     Json?
  regen_count Int?      @db.SmallInt
  client      clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([created_at(sort: Desc)])
  @@index([gate, created_at(sort: Desc)])
  @@index([severity, created_at(sort: Desc)])
  @@index([client_id])
}

// Clinical Library (admin-curated corpus for the future Assessment Builder). Separate from the note-gen
// KB (behaviors/topographies/replacement_skills) so curation can't affect note generation. One row per
// canonical entry (unique kind+canonical_key); variants/functions accumulate. See migration
// 20260822000000_clinical_library. Populated fail-soft from the ingest hook; a PHI discard filter runs first.
model clinical_library {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  canonical_key String
  display_name  String
  variants      String[] @default([])
  functions     String[] @default([])
  meta          Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([kind, canonical_key])
  @@index([kind])
}

model clinical_library_discards {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  reason     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([reason])
  @@index([created_at])
}

// Admin alerts — the operational event feed behind the admin "auditors" panel. Distinct from
// gate_findings: that table records which CLINICAL gate fired on a note that shipped (defect-only,
// silent on a clean note); this one records what HAPPENED in the system, succeeded or failed. First
// producer is the note-generation hard-failure path, which previously left no trace at all. See
// migration 20260826000000_admin_alerts. Written only through emitAdminAlert (lib/adminAlerts.ts),
// which is fail-soft — an unapplied migration degrades to a log line, never an outage.
//
// client_id / actor_user_id are plain TEXT with NO relation, deliberately: an alert is evidence of
// something that already went wrong, so it must outlive the row it refers to (no CASCADE) and the
// emitter must never fail on a malformed id. payload holds diagnostics only — never note text.
model admin_alerts {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  source        String
  type          String
  severity      String
  actor_user_id String?
  client_id     String?
  payload       Json      @default("{}") @db.JsonB
  read_at       DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@index([severity, read_at])
  @@index([type, created_at(sort: Desc)])
}
